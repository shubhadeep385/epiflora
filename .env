
AI_PROVIDER_CHAIN=gemini,openrouter,ollama,demo

# Ordered Gemini model preference. Verified available 2026-08-17.
# IMPORTANT: Google no longer publishes a fixed free-tier quota table. Check your
# own project's real limits at https://aistudio.google.com/rate-limit and reorder
# this list so the model with the largest requests-per-day sits first.
AI_MODEL_CHAIN=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.7-flash

# https://aistudio.google.com/apikey  (free tier, no billing account required)
GEMINI_API_KEY=
# low | medium | high — Gemini 3.x replaced thinking_budget with thinking_level.
GEMINI_THINKING_LEVEL=low

# https://openrouter.ai/keys — fallback. Free model IDs are resolved at runtime
# from /api/v1/models because the free roster changes week to week.
OPENROUTER_API_KEY=
OPENROUTER_FREE_ONLY=true

# Fully local fallback. No key, no quota, no network.
OLLAMA_BASE_URL=http://localhost:11434
# Defaults to Google Gemma 4 (gemma4:latest / gemma4:27b / gemma2)
OLLAMA_MODEL=gemma4:latest

# https://huggingface.co/settings/tokens — last-resort cloud fallback.
HF_TOKEN=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

# ── Language layer (Sarvam) ──────────────────────────────────────────────────
# Sarvam is NOT permanently free: ~Rs.100 of signup credit, then pay-per-use.
# The budget guard demotes to local/browser voice when credit runs out.
VOICE_PROVIDER=sarvam
SARVAM_API_KEY=sk_sb9hj3gw_CVrgEz0wcVs1nyZuuyRdhAkb
SARVAM_STT_MODEL=saaras:v3
# transcribe | translate | verbatim | translit | codemix
# codemix is the default: farmers naturally mix Hindi and English mid-sentence.
SARVAM_STT_MODE=codemix
SARVAM_TTS_MODEL=bulbul:v3

# ── Environment data ─────────────────────────────────────────────────────────
# Open-Meteo needs no API key for prototype-scale usage.
OPEN_METEO_BASE_URL=https://api.open-meteo.com

# ── Guards ───────────────────────────────────────────────────────────────────
# Soft daily ceiling per provider. At 80% the registry pre-emptively demotes.
DAILY_REQUEST_BUDGET=200
# Force seeded, clearly-labelled demo responses. Useful for offline rehearsal.
DEMO_MODE=false

# Local dev only. The Vite dev server proxies /api to this port.
API_DEV_PORT=8787
